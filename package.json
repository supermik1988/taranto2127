{
  "name": "taranto2127",
  "version": "0.0.0",
  "private": true,
  "description": "Gestionale civico a turni sul futuro di Taranto, 2027-2127.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/game/tsconfig.json",
    "lint": "eslint .",
