          "minLength": 1
        },
        "scandalo": {
          "type": "string",
          "minLength": 1
        },
        "promessa-mantenuta": {
          "type": "string",
          "minLength": 1
        },
        "promessa-tradita": {
          "type": "string",
          "minLength": 1
        },
        "in-esercizio": {
          "type": "string",
          "minLength": 1
        },
        "cantiere-apre": {
          "type": "string",
          "minLength": 1
        },
        "cantiere-fermo": {
          "type": "string",
          "minLength": 1
        },
        "quartiere-fiducia": {
          "type": "string",
          "minLength": 1
        },
        "quartiere-salute": {
          "type": "string",
          "minLength": 1
        },
        "quartiere-aria": {
          "type": "string",
          "minLength": 1
        },
        "quartiere-tensione": {
          "type": "string",
          "minLength": 1
        },
        "nessuna": {
          "type": "string",
          "minLength": 1
        }
