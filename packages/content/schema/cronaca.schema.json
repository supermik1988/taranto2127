      "required": [
        "fiducia",
        "salute",
        "aria",
        "tensione"
      ],
      "properties": {
        "fiducia": {
          "$ref": "comune.json#/$defs/nonNegativo"
        },
        "salute": {
          "$ref": "comune.json#/$defs/nonNegativo"
        },
        "aria": {
          "$ref": "comune.json#/$defs/nonNegativo"
        },
        "tensione": {
          "$ref": "comune.json#/$defs/nonNegativo"
        }
      },
      "additionalProperties": false
    },
    "titoli": {
      "type": "object",
      "required": [
        "dissesto",
        "abbandono",
        "fine",
        "scandalo-scorciatoia",
        "scandalo-dilemma",
        "scandalo",
        "promessa-mantenuta",
        "promessa-tradita",
        "in-esercizio",
        "cantiere-apre",
        "cantiere-fermo",
        "quartiere-fiducia",
        "quartiere-salute",
        "quartiere-aria",
        "quartiere-tensione",
        "nessuna"
      ],
      "properties": {
