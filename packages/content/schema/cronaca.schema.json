        },
        "abbandono": {
          "type": "string",
          "minLength": 1
        },
        "fine": {
          "type": "string",
          "minLength": 1
        },
        "scandalo-scorciatoia": {
          "type": "string",
          "minLength": 1
        },
        "scandalo-dilemma": {
