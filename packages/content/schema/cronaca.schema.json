{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.taranto2127.invalid/cronaca.json",
  "title": "La Cronaca: soglie e titoli",
  "type": "object",
  "required": [
    "descrizione",
    "soglie",
    "titoli"
  ],
