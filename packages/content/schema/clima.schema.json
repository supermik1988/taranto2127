{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.taranto2127.invalid/clima.json",
  "title": "Scenario climatico per le cinque epoche",
  "type": "object",
  "required": ["climateScenario"],
  "properties": {
    "climateScenario": {
      "type": "object",
      "required": ["id", "nome", "descrizione", "annualChangeByEpoch"],
      "properties": {
        "id": { "$ref": "comune.json#/$defs/id" },
        "nome": { "$ref": "comune.json#/$defs/testo" },
        "descrizione": { "$ref": "comune.json#/$defs/testo" },
        "annualChangeByEpoch": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["seaLevelRiseCm", "summerHeat", "waterStress"],
            "properties": {
              "seaLevelRiseCm": { "$ref": "comune.json#/$defs/numero" },
              "summerHeat": { "$ref": "comune.json#/$defs/numero" },
              "waterStress": { "$ref": "comune.json#/$defs/numero" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
